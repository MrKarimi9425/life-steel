NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=life-steel-backend
JWT_AUDIENCE=life-steel-admin
OWNER_PHONE_NUMBER=09XXXXXXXXX
OWNER_TEMPORARY_PASSWORD=GENERATE_A_UNIQUE_TEMPORARY_PASSWORD
OWNER_FIRST_NAME=نام
OWNER_LAST_NAME=نام_خانوادگی
MEDIA_STORAGE_PATH=storage/media
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=250
